{
  "name": "aereal.github.com",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "deploy": "firebase deploy --only hosting",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "predeploy": "next build",
    "type-check": "tsc -p . --noEmit",
    "type-check:watch": "tsc -p . --noEmit -w",
    "test": "jest",
    "e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aereal/aereal.github.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aereal/aereal.github.com/issues"
  },
  "homepage": "https://github.com/aereal/aereal.github.com#readme",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/styled-components": "5.1.34",
    "@typescript-eslint/eslint-plugin": "8.25.0",
    "@typescript-eslint/parser": "8.25.0",
    "babel-plugin-styled-components": "2.1.4",
    "eslint": "9.21.0",
    "eslint-config-next": "15.1.7",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.4",
    "eslint-plugin-react-hooks": "5.1.0",
    "firebase-tools": "15.35.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "next": "15.1.7",
    "npm-run-all2": "5.0.2",
    "prettier": "3.5.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-is": "18.2.0",
    "serve-handler": "6.1.6",
    "styled-components": "6.1.15",
    "ts-jest": "29.2.6",
    "typescript": "4.9.5",
    "yaml": "2.9.1"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "es5",
    "jsxBracketSameLine": true
  },
  "babel": {
    "presets": [
      "next/babel"
    ],
    "plugins": [
      [
        "styled-components",
        {
          "ssr": true
        }
      ]
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "testRegex": "(\\.|/)(test|spec)\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
