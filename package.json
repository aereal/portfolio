{
  "name": "aereal.github.com",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "deploy": "firebase deploy --only hosting",
    "build": "nuxt generate",
    "dev": "nuxt dev",
    "start": "nuxt preview",
    "predeploy": "nuxt generate",
    "postinstall": "nuxt prepare",
    "type-check": "nuxt typecheck",
    "test": "jest",
    "e2e": "playwright test",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aereal/aereal.github.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/aereal/aereal.github.com/issues"
  },
  "homepage": "https://github.com/aereal/aereal.github.com#readme",
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/jest": "29.5.14",
    "@types/node": "26.6.6",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "9.21.0",
    "eslint-config-prettier": "10.0.1",
    "eslint-plugin-prettier": "5.2.3",
    "eslint-plugin-vue": "10.12.0",
    "firebase-tools": "15.35.0",
    "globals": "16.0.0",
    "jest": "29.7.0",
    "npm-run-all2": "5.0.2",
    "nuxt": "4.6.4",
    "prettier": "3.5.2",
    "serve-handler": "6.1.6",
    "tailwindcss": "4.3.5",
    "ts-jest": "29.2.6",
    "typescript": "5.9.3",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  },
  "prettier": {
    "semi": false,
    "trailingComma": "es5"
  },
  "jest": {
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tests/tsconfig.json"
        }
      ]
    },
    "testRegex": "(\\.|/)(test|spec)\\.tsx?$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ]
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
